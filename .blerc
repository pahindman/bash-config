# shellcheck shell=bash
# When updating ble.sh, this file:
# 	~/.local/share/blesh/contrib/integration/fzf-completion.bash
# needs to be updated to add the s/builtin printf/printf/ command, like below:
#	ble/util/eval-stdout '"$_ble_contrib_fzf_path" --bash | sed "s/builtin printf/printf/g" | sed -n "/### completion/,/### end/p"'

function blerc/vim-load-hook {
	bleopt keymap_vi_mode_show=
}
blehook/eval-after-load keymap_vi blerc/vim-load-hook

ble-bind -m vi_imap -f 'C-c' discard-line
ble-bind -m vi_nmap -f 'C-c' discard-line

ble-import -d integration/fzf-completion
#ble-import -d integration/fzf-key-bindings
#_ble_contrib_fzf_git_config=key-binding:sabbrev:arpeggio
#ble-import -d integration/fzf-git
#ble-import -d integration/fzf-menu
